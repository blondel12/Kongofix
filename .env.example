# =============================================================================
# KongoFix — Variables d'environnement
# =============================================================================
# Copiez ce fichier en .env et renseignez les valeurs correspondantes.
# Ne commitez JAMAIS le fichier .env (il est dans .gitignore).

# ---------------------------------------------------------------------------
# Base de données — PostgreSQL Neon (obligatoire)
# ---------------------------------------------------------------------------
# Format : postgresql://user:password@host:port/database?sslmode=require
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-XXXX.us-east-2.aws.neon.tech/neondb?sslmode=require

# ---------------------------------------------------------------------------
# API Email (optionnel)
# ---------------------------------------------------------------------------
# Utilisé pour l'envoi d'emails transactionnels (vérification, notifications).
# Laissez vide pour désactiver l'envoi d'emails.
EMAIL_API_URL=
EMAIL_API_KEY=

# ---------------------------------------------------------------------------
# Session (optionnel)
# ---------------------------------------------------------------------------
# Clé secrète pour le chiffrement des sessions côté serveur.
# Générez une chaîne aléatoire longue (ex: openssl rand -base64 32).
# Si laissée vide, une clé par défaut non sécurisée sera utilisée.
SESSION_SECRET=
